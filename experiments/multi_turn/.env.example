# --- API keys (at least OPENROUTER_API_KEY is required) ---
OPENROUTER_API_KEY=
# Only needed when the target model is routed direct:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional overrides ---
# Comma-separated extra model IDs to route via the direct OpenAI API
#OPENAI_TARGET_MODELS_EXTRA=
# Set to 1/true to force Anthropic models through OpenRouter instead of direct
#ANTHROPIC_DIRECT_TARGET_DISABLE=
# Max output tokens for direct Anthropic target calls
#ANTHROPIC_MAX_OUTPUT_TOKENS=16384
# Set to 1/true to re-extract broad_topic values that already exist
#FORCE_OVERRIDE_BROAD_TOPIC=
